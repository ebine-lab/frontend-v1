{
  "name": "@nijiurachan/frontend-v1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "dev:prod": "VITE_BASE_URL=https://nijiurachan.net VITE_TURNSTILE_SITE_KEY=0x4AAAAAACC1fRCF2ECj_4xK vite",
    "build": "tsr generate && vite build",
    "build:local": "VITE_BASE_URL=http://localhost:8080 VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA bun run build",
    "build:prod": "VITE_BASE_URL=https://nijiurachan.net VITE_TURNSTILE_SITE_KEY=0x4AAAAAACC1fRCF2ECj_4xK bun run build",
    "clean": "git clean -fdX .bun node_modules src dist",
    "tsc": "tsc --build",
    "lint": "eslint . && biome check",
    "fix": "biome check --fix --unsafe",
    "format": "biome format --fix",
    "preview": "bun run build && wrangler dev",
    "preview:local": "bun run build:local && wrangler dev",
    "preview:prod": "bun run build:prod && wrangler dev",
    "routes": "tsr generate",
    "deploy": "bun run build && wrangler deploy",
    "check": "biome check"
  },
  "trustedDependencies": [
    "@nijiurachan/js"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.91.3",
    "@tanstack/react-router": "^1.168.1",
    "clsx": "^2.1.1",
    "linkifyjs": "^4.3.2",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "*note*": [
    "開発するときには",
    "bun link --save @nijiurachan/js を使うのがおすすめです"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "@eslint/js": "^9.39.4",
    "@nijiurachan/js": "github:nijiurachan/nijiurachan-js#4269645de577f162773ecc69268783e9d2aac10a",
    "@tanstack/router-cli": "^1.166.16",
    "@tanstack/router-plugin": "^1.167.2",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "axnospaint-for-aimg": "github:nijiurachan/axnospaint-for-aimg#905abd0ab97cef8ef9c14ada6e5bef126352b999",
    "dompurify": "3.4.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lodash-es": "4.18.1",
    "preact": "^10.28.3",
    "ts-essentials": "^10.1.1",
    "typescript": "6",
    "typescript-eslint": "^8.57.1",
    "unplugin": "3.0.0",
    "vite": "^8.0.10",
    "wrangler": "^4.94.0"
  }
}
